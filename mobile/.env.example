# Copy this file to .env and fill in real values (never commit .env — the
# repo root .gitignore already ignores it).
#
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time
# (standard Expo mechanism) — matches the backend's own lab-grade shared
# bearer-token auth model. See docs/product/non-functional-requirements.md
# and backend/app/api/deps.py for why this is the intentional posture here.

# Base URL of the backend Container App. Defaults to the dev environment if
# unset — override to point at prod, or a local backend, as needed.
EXPO_PUBLIC_BACKEND_URL=https://ca-socanalyst-dev.mangofield-d09bdeea.canadacentral.azurecontainerapps.io

# Shared bearer token — must match the backend's BACKEND_API_KEY for the
# target environment. No default; the app throws a clear config error if
# this is unset rather than silently failing auth.
EXPO_PUBLIC_BACKEND_API_KEY=
